    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.9",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "svelte": "^5.12.0",
    "svelte-check": "^4.1.0",
    "svelte-meta-tags": "^4.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@duckdb/duckdb-wasm": "^1.32.0",
